FROM ghcr.io/ptero-eggs/yolks:nodejs_22 AS toolchain

USER root

ARG TARGETARCH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "${TARGETARCH}" in \
        amd64) ytdlp_asset="yt-dlp_linux"; cloudflared_arch="amd64" ;; \
        arm64) ytdlp_asset="yt-dlp_linux_aarch64"; cloudflared_arch="arm64" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}"; exit 1 ;; \
    esac; \
    curl -fSL --connect-timeout 15 --max-time 180 --retry 3 \
        "https://github.com/yt-dlp/yt-dlp-nightly-builds/releases/latest/download/${ytdlp_asset}" \
        -o /tmp/yt-dlp; \
    curl -fSL --connect-timeout 15 --max-time 180 --retry 3 \
        "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${cloudflared_arch}" \
        -o /tmp/cloudflared; \
    install -m 0755 /tmp/yt-dlp /usr/local/bin/yt-dlp; \
    install -m 0755 /tmp/cloudflared /usr/local/bin/cloudflared; \
    rm -f /tmp/yt-dlp /tmp/cloudflared

RUN node --version \
    && npm --version \
    && python3 --version \
    && ffmpeg -version \
    && yt-dlp --version \
    && cloudflared --version

FROM toolchain AS installer

USER root
WORKDIR /mnt/server

FROM toolchain AS runtime

USER container
WORKDIR /home/container
